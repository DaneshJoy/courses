{
  "name": "courses-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "PORTAL_LOCAL=1 npm run generate-catalog && vite",
    "build": "npm run generate-catalog && tsc --noEmit && vite build",
    "build:local": "sh -c 'PORTAL_LOCAL=1 npm run generate-catalog && tsc --noEmit && vite build'",
    "preview": "vite preview",
    "generate-catalog": "node scripts/generate-catalog.cjs",
    "generate-catalog:local": "PORTAL_LOCAL=1 node scripts/generate-catalog.cjs",
    "validate": "node scripts/generate-catalog.cjs --validate-only",
    "validate:local": "PORTAL_LOCAL=1 node scripts/generate-catalog.cjs --validate-only",
    "test": "vitest run tests/*.test.ts tests/*.test.tsx && playwright test",
    "check": "npm run validate && npm run build && npm run test",
    "check:local": "npm run validate:local && npm run build:local && npm run test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
