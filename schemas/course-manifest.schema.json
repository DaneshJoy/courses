{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course manifest (course.json)",
  "description": "Manifest shipped by each course repo; fetched and validated at portal build time.",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "language",
    "dir",
    "level",
    "category",
    "tags",
    "lectures",
    "schemaVersion",
    "templateVersion",
    "license",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "description": "BCP-47 language tag, e.g. fa, fa-IR, en.",
      "type": "string",
      "format": "bcp47"
    },
    "dir": {
      "enum": ["rtl", "ltr"]
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0,
      "uniqueItems": true
    },
    "lectures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "order", "durationMinutes", "objectives", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 0
          },
          "objectives": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "status": {
            "enum": ["draft", "review", "published"]
          }
        }
      }
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "templateVersion": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "description": "ISO 8601 date (YYYY-MM-DD) or date-time.",
      "type": "string",
      "format": "iso-date"
    }
  }
}
